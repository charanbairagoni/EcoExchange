generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SELLER
  BUYER
  ADMIN
}

enum OrderType {
  SELL
  BUY
}

enum OrderStatus {
  LISTED
  ORDER_PLACED
  ADMIN_REVIEW
  FORWARDED_TO_LOGISTICS
  PICKUP_SCHEDULED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum LogisticsStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model User {
  id              String    @id @default(cuid())
  industryName    String
  ownerName       String
  email           String    @unique
  location        String
  contactNumber   String
  passwordHash    String
  roles           Role[]    @default([BUYER])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  wasteListings   WasteListing[] @relation("SellerListings")
  buyOrders       Order[]        @relation("BuyerOrders")
  sellOrders      Order[]        @relation("SellerOrders")
  sellerConversations Conversation[] @relation("ConversationSeller")
  buyerConversations  Conversation[] @relation("ConversationBuyer")
  adminConversations  Conversation[] @relation("ConversationAdmin")
  sentMessages     Message[]      @relation("MessageSender")
  receivedMessages Message[]      @relation("MessageReceiver")
}

model WasteListing {
  id              String    @id @default(cuid())
  wasteType       String
  quantity        Float
  unit            String
  price           Float
  location        String
  description     String
  imageUrl        String?
  sellerId        String
  seller          User      @relation("SellerListings", fields: [sellerId], references: [id])
  availability    String    @default("Available")
  status          String    @default("LISTED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  orders          Order[]
  @@index([sellerId])
  @@index([wasteType, location])
}

model Order {
  id                 String           @id @default(cuid())
  orderCode          String           @unique
  orderType          OrderType
  buyerId            String
  sellerId           String
  wasteListingId     String?
  wasteType          String
  quantity           Float
  location           String
  basePrice          Float
  buyerCommission    Float
  sellerCommission   Float
  transportCharge    Float
  finalAmount        Float
  status             OrderStatus      @default(ORDER_PLACED)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  buyer              User             @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller             User             @relation("SellerOrders", fields: [sellerId], references: [id])
  wasteListing       WasteListing?    @relation(fields: [wasteListingId], references: [id])
  logisticsRequest   LogisticsRequest?
  transaction        Transaction?
  conversations      Conversation[]
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model Conversation {
  id          String             @id @default(cuid())
  orderId     String             @unique
  sellerId    String
  buyerId     String
  adminId     String
  status      ConversationStatus @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  order       Order              @relation(fields: [orderId], references: [id])
  seller      User               @relation("ConversationSeller", fields: [sellerId], references: [id])
  buyer       User               @relation("ConversationBuyer", fields: [buyerId], references: [id])
  admin       User               @relation("ConversationAdmin", fields: [adminId], references: [id])
  messages    Message[]
  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     Role
  receiverId     String
  receiverRole   Role
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  receiver       User         @relation("MessageReceiver", fields: [receiverId], references: [id])
  @@index([conversationId, createdAt])
  @@index([receiverId, isRead])
}

model LogisticsCompany {
  id              String    @id @default(cuid())
  companyName     String
  contactNumber   String
  serviceArea     String
  status          String    @default("Active")
  createdAt       DateTime  @default(now())
  logisticsRequests LogisticsRequest[]
}

model LogisticsRequest {
  id               String           @id @default(cuid())
  requestCode      String           @unique
  orderId          String           @unique
  order            Order            @relation(fields: [orderId], references: [id])
  logisticsCompanyId String?
  logisticsCompany  LogisticsCompany? @relation(fields: [logisticsCompanyId], references: [id])
  pickupLocation   String
  deliveryLocation String
  wasteType        String
  quantity         Float
  transportCharge  Float
  status           LogisticsStatus  @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  @@index([logisticsCompanyId])
}

model Transaction {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  type        String
  amount      Float
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
}
